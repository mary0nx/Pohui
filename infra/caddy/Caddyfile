# Family OS reverse proxy.
# SITE_ADDRESS: "family.example.com" in production (automatic Let's Encrypt HTTPS),
# ":80" for local runs without TLS.
{
	email {$ACME_EMAIL:admin@example.com}
	servers {
		trusted_proxies static private_ranges
	}
}

{$SITE_ADDRESS::80} {
	encode zstd gzip

	request_body {
		max_size 20MB
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		# Telegram Web embeds Mini Apps in an iframe; only its origins may frame us.
		Content-Security-Policy "default-src 'self'; script-src 'self' https://telegram.org; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://t.me https://*.telegram.org https://*.t.me; connect-src 'self'; font-src 'self'; frame-ancestors 'self' https://web.telegram.org https://*.telegram.org; base-uri 'none'; form-action 'self'; object-src 'none'"
		-Server
	}

	handle /api/* {
		reverse_proxy api:8000
	}
	handle /health* {
		reverse_proxy api:8000
	}
	# Telegram webhook (bot process, secret token checked by aiogram).
	handle /tg/* {
		reverse_proxy bot:8081
	}

	handle {
		root * /srv
		@assets path /assets/*
		header @assets Cache-Control "public, max-age=31536000, immutable"
		@html path / /index.html
		header @html Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}

	log {
		output stdout
		format json
	}
}
