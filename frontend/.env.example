# Frontend build settings. Vite inlines VITE_* variables at BUILD time: changing them
# requires a new build (on Cloudflare Pages: Settings -> Variables and Secrets, then redeploy).
# Never put secrets here — everything in VITE_* ends up in public JavaScript.

# Origin of the FastAPI backend, without a path and without a trailing slash.
# Leave empty when the frontend is served by Caddy next to the API (compose.yaml)
# or by the Vite dev server (it proxies /api to localhost:8000).
VITE_API_URL=
