# Family OS configuration. Copy to .env and fill in. Never commit .env.
# Generate secrets with:  python3 -c "import secrets; print(secrets.token_urlsafe(48))"

# --- Application -------------------------------------------------------------
APP_ENV=production                 # development | test | production
APP_SECRET_KEY=                    # REQUIRED in production, >= 32 chars (signs download links)
LOG_LEVEL=INFO
DEFAULT_TIMEZONE=Europe/Warsaw
DEFAULT_CURRENCY=PLN

# Public URLs (HTTPS in production). Mini App and API share one domain behind Caddy.
FRONTEND_URL=https://family.example.com
BACKEND_URL=https://family.example.com
CORS_ORIGINS=https://family.example.com
# Optional regex for more origins, e.g. Cloudflare Pages build previews:
# CORS_ORIGIN_REGEX=^https://[a-z0-9-]+\.my-family-app\.pages\.dev$

# Development only: explicit fake login without Telegram. The app refuses to start
# with this enabled when APP_ENV=production.
DEV_AUTH_ENABLED=false

# --- Database (docker compose builds DATABASE_URL from these) --------------------
POSTGRES_USER=familyos
POSTGRES_PASSWORD=                 # REQUIRED, long random value
POSTGRES_DB=familyos
# For running the backend outside Docker:
# DATABASE_URL=postgresql+asyncpg://familyos:password@localhost:5432/familyos
# Hosted PostgreSQL strings (postgresql://...?sslmode=require) are accepted as given.
# DATABASE_PASSWORD=               # optional: replaces the password inside DATABASE_URL
# DB_POOL_SIZE=10
# DB_MAX_OVERFLOW=10
# REDIS_URL=redis://localhost:6379/0   # optional: rate limiting falls back to memory

# --- Telegram ------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=                # from @BotFather; REQUIRED in production
TELEGRAM_BOT_USERNAME=             # without @, used for invitation links
TELEGRAM_MINI_APP_SHORT_NAME=      # optional, short name from /newapp; invites go through the bot (?start=inv_...)
TELEGRAM_INIT_DATA_MAX_AGE=86400   # seconds an initData signature is accepted
BOT_MODE=webhook                   # polling (dev) | webhook (production)
TELEGRAM_WEBHOOK_URL=https://family.example.com/tg/webhook
TELEGRAM_WEBHOOK_SECRET=           # random 32+ chars, letters/digits/_/- only (derived from APP_SECRET_KEY if empty)

# --- Single-process mode (one web service, e.g. Render free; see render.yaml) ----
# EMBEDDED_WORKER=true             # run reminders/notifications inside the API process
# EMBEDDED_BOT=true                # receive Telegram updates at <BACKEND_URL>/tg/webhook in the API
COMPOSE_PROFILES=bot               # start the bot container with docker compose

# --- AI (optional: everything else works without it) ----------------------------
AI_PROVIDER=openai                 # openai | disabled
OPENAI_API_KEY=
AI_MODEL=                          # e.g. a current OpenAI chat model id from the OpenAI docs

# «Мой маршрут» (docs/MY_ROUTE.md). The Wrocław open data schedule needs no key.
TRANSIT_UPDATES_ENABLED=true       # hourly check of the official GTFS file
# Optional: Jakdojade partner API keys (issued on request by biuro@jakdojade.pl). Empty = not used.
JAKDOJADE_API_KEY=
JAKDOJADE_API_SECRET=
OPENAI_BASE_URL=                   # optional OpenAI-compatible endpoint
AI_DAILY_REQUESTS_PER_USER=100
AI_DAILY_TOKENS_PER_FAMILY=400000
AI_PROPOSAL_TTL_MINUTES=30

# --- File storage ----------------------------------------------------------------
STORAGE_BACKEND=local              # local (docker volume) | s3
MAX_UPLOAD_MB=15
# Product thumbnails come from the bundled catalogue (no external service needed). Only if an
# external image source is wired in later: https hosts it may serve pictures from, comma-separated.
IMAGE_ALLOWED_HOSTS=
# S3-compatible storage (only when STORAGE_BACKEND=s3):
STORAGE_ENDPOINT=
STORAGE_REGION=auto
STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=

# --- Reverse proxy -----------------------------------------------------------------
SITE_ADDRESS=family.example.com    # ":80" to run locally without TLS
ACME_EMAIL=you@example.com         # Let's Encrypt account e-mail
HTTP_PORT=80
HTTPS_PORT=443
# Cloudflare Tunnel (optional): set SITE_ADDRESS=:80, add "tunnel" to COMPOSE_PROFILES
# and paste the tunnel token from Cloudflare Zero Trust -> Networks -> Tunnels.
CLOUDFLARE_TUNNEL_TOKEN=

# --- Backups -----------------------------------------------------------------------
BACKUP_DIR=./backups
BACKUP_KEEP_DAYS=14
RCLONE_REMOTE=                     # e.g. "b2:familyos-backups" — off-site copy (strongly recommended)
